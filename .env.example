# Which local Ollama model to use for the agent + SQL generation.
# Must be a model that supports tool/function calling in Ollama.
# Good options from your `ollama list`: qwen3:8b, qwen2.5-coder:14b, qwen2.5-coder:7b
OLLAMA_MODEL=qwen3:8b

# Optional: if you later want to swap DuckDuckGo for Tavily (free tier, more reliable)
# TAVILY_API_KEY=your_key_here
